# GateMate EVB pinout for current RISC-V SoC wrapper

# 10 MHz on-board clock
Pin_in "clk_i" Loc = "IO_SB_A8";

# User button, low-active
Pin_in "rstn_i" Loc = "IO_EB_B0" | SCHMITT_TRIGGER=true;

# User LED
Pin_out "led_o" Loc = "IO_EB_B1";

# UART RX from PMOD / USB-UART
Pin_out "txd_o" Loc = "IO_NB_A4"; # pin 1
Pin_in "rxd_i" Loc = "IO_NB_B4" | SCHMITT_TRIGGER=true;